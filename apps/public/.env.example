DATABASE_HOST=localhost
DATABASE_PORT=25061
DATABASE_USER=root
DATABASE_PASSWORD=your-password
DATABASE_NAME=mpga-data

REVALIDATE_SECRET=your-secret-here

MATCH_PLAY_DEADLINE="2026-03-15"
MATCH_PLAY_PUBLISH="2026-03-24"

SEASON_YEAR=2025

NEXT_PUBLIC_ADMIN_URL=http://localhost:4100

# PostHog (error tracking)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Contact form (runtime settings; no image rebuild needed for key changes)
TURNSTILE_SITE_KEY=
# Same random secret on public and admin (openssl rand -hex 32)
CONTACT_FORM_SECRET=
# A single-IP header OVERWRITTEN by your trusted ingress; CapRover commonly uses x-real-ip.
# Verify proxy configuration and block direct access to the app before enabling.
CONTACT_CLIENT_IP_HEADER=x-real-ip
